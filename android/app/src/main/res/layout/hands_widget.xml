<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background">
<TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HISTORY OF HANDS · YOU &amp; HER" android:textColor="#25392f" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" />
<TextView android:id="@+id/advice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Mix your throws · building a history" android:textColor="#25392f" android:textSize="18sp" android:maxLines="2" android:textStyle="bold" />
<TextView android:id="@+id/score" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="You 0 · Her 0 · Ties 0" android:textColor="#72766b" android:textSize="11sp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="TAP A PAIR: YOUR THROW / HER THROW" android:textColor="#72766b" android:textSize="11sp" />

<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
<TextView android:id="@+id/pair_0_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:minHeight="48dp" android:gravity="center" android:text="✊ / ✊" android:contentDescription="You rock, her rock" android:textColor="#25392f" android:textSize="22sp" android:background="@drawable/cell_background" />
<TextView android:id="@+id/pair_0_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:minHeight="48dp" android:gravity="center" android:text="✊ / ✋" android:contentDescription="You rock, her paper" android:textColor="#25392f" android:textSize="22sp" android:background="@drawable/cell_background" />
<TextView android:id="@+id/pair_0_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:minHeight="48dp" android:gravity="center" android:text="✊ / ✌" android:contentDescription="You rock, her scissors" android:textColor="#25392f" android:textSize="22sp" android:background="@drawable/cell_background" />
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
<TextView android:id="@+id/pair_1_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:minHeight="48dp" android:gravity="center" android:text="✋ / ✊" android:contentDescription="You paper, her rock" android:textColor="#25392f" android:textSize="22sp" android:background="@drawable/cell_background" />
<TextView android:id="@+id/pair_1_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:minHeight="48dp" android:gravity="center" android:text="✋ / ✋" android:contentDescription="You paper, her paper" android:textColor="#25392f" android:textSize="22sp" android:background="@drawable/cell_background" />
<TextView android:id="@+id/pair_1_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:minHeight="48dp" android:gravity="center" android:text="✋ / ✌" android:contentDescription="You paper, her scissors" android:textColor="#25392f" android:textSize="22sp" android:background="@drawable/cell_background" />
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
<TextView android:id="@+id/pair_2_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:minHeight="48dp" android:gravity="center" android:text="✌ / ✊" android:contentDescription="You scissors, her rock" android:textColor="#25392f" android:textSize="22sp" android:background="@drawable/cell_background" />
<TextView android:id="@+id/pair_2_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:minHeight="48dp" android:gravity="center" android:text="✌ / ✋" android:contentDescription="You scissors, her paper" android:textColor="#25392f" android:textSize="22sp" android:background="@drawable/cell_background" />
<TextView android:id="@+id/pair_2_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:minHeight="48dp" android:gravity="center" android:text="✌ / ✌" android:contentDescription="You scissors, her scissors" android:textColor="#25392f" android:textSize="22sp" android:background="@drawable/cell_background" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="Ready. Saves offline, too." android:textColor="#72766b" android:textSize="11sp" android:maxLines="2"/>
<TextView android:id="@+id/undo" android:layout_width="64dp" android:layout_height="match_parent" android:gravity="center" android:text="Undo ↶" android:textColor="#ba593e" android:textSize="12sp"/>
</LinearLayout></LinearLayout>